{
  "name": "react-secure-storage",
  "version": "1.4.0",
  "description": "Securely store data in browser localStorage, safe for SSR and CSR",
  "author": "Sushin Pv",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sushinpv/react-secure-storage.git"
  },
  "license": "MIT",
  "keywords": [
    "react secure local storage",
    "react",
    "local storage",
    "ssr",
    "nextjs",
    "vite"
  ],
  "dependencies": {
    "crypto-js": "^4.1.1",
    "murmurhash-js": "^1.0.0"
  },
  "scripts": {
    "build:lib": "rm -rf dist && NODE_ENV=production babel src/lib --out-dir dist --extensions \".ts,.tsx\" --ignore \"src/lib/**/*.d.ts\" && cp src/lib/types.d.ts dist/types.d.ts && cp src/lib/types.react.d.ts dist/react.d.ts && node scripts/cjs-interop.mjs",
    "prepack": "npm run build:lib",
    "typecheck": "tsc -p tsconfig.lib.json",
    "test": "npm run build:lib && vitest run",
    "test:coverage": "npm run build:lib && vitest run --coverage",
    "test:e2e": "playwright test",
    "pack:e2e": "node scripts/pack-for-e2e.mjs",
    "size": "node scripts/check-size.mjs",
    "start": "react-scripts start",
    "build": "react-scripts build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.2",
    "@babel/plugin-proposal-class-properties": "^7.17.12",
    "@babel/plugin-proposal-object-rest-spread": "^7.18.0",
    "@babel/plugin-transform-classes": "^7.18.4",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-typescript": "^7.17.12",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^27.5.2",
    "@types/jsdom": "^30.0.0",
    "@types/murmurhash-js": "^1.0.3",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "core-js": "^3.22.8",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-secure-storage-legacy": "npm:react-secure-storage@1.3.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "web-vitals": "^2.1.4"
  },
  "files": [
    "dist",
    "react"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
